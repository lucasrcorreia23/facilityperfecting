# ── Front (browser) ───────────────────────────────────────────────
# Projeto Supabase do produto externo (NÃO é o backend da Perfecting).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── Edge Functions (supabase secrets set ...) ─────────────────────
# Estes NÃO vão no .env.local do front — são secrets das Edge Functions.
# Definir com:  supabase secrets set PERFECTING_HML_API_BASE=... etc.
#
# Perfecting HML
# PERFECTING_HML_API_BASE=https://api-hml.perfecting.app
# PERFECTING_HML_SUPERADMIN_EMAIL=...
# PERFECTING_HML_SUPERADMIN_PASSWORD=...
#
# Perfecting produção
# PERFECTING_PROD_API_BASE=https://api.perfecting.app
# PERFECTING_PROD_SUPERADMIN_EMAIL=...
# PERFECTING_PROD_SUPERADMIN_PASSWORD=...
#
# Fallback legado (email/senha): usados se HML_* ou PROD_* SUPERADMIN faltarem.
# PERFECTING_API_BASE legado só preenche HML se PERFECTING_HML_API_BASE faltar.
# PERFECTING_API_BASE=https://api-hml.perfecting.app
# PERFECTING_SUPERADMIN_EMAIL=...
# PERFECTING_SUPERADMIN_PASSWORD=...
#
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-sonnet-5   # default no código; a key precisa ter acesso ao ID
# SUPABASE_URL=...                # injetado automaticamente pelo runtime
# SUPABASE_SERVICE_ROLE_KEY=...   # injetado automaticamente pelo runtime
